/** JAIN AUTO — Google Apps Script backend
 * Sheet tabs: Owners and Status
 * Owners columns: userId | password | name | phone | address | mapUrl | hours
 * Status columns: key | value
 * Deploy as Web app: Execute as Me; Who has access: Anyone.
 */
const OWNER_SHEET='Owners', STATUS_SHEET='Status';
function doGet(e){const p=e.parameter||{}, action=p.action||'status'; let out={ok:false}; try{if(action==='status')out=statusResponse(); else if(action==='login')out=login(p.userId,p.password); else if(action==='session')out=session(p.userId,p.token); else if(action==='update')out=update(p); else out={ok:false,error:'Unknown action'};}catch(err){out={ok:false,error:String(err.message||err)}} return output(out,p.callback)}
function output(obj,callback){const json=JSON.stringify(obj); if(callback) return ContentService.createTextOutput(callback+'('+json+')').setMimeType(ContentService.MimeType.JAVASCRIPT); return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON)}
function sheet(name){return SpreadsheetApp.getActive().getSheetByName(name)}
function rows(name){const s=sheet(name); if(!s)return []; const v=s.getDataRange().getValues(); const h=v.shift().map(String); return v.filter(r=>r.some(x=>x!=='')).map(r=>Object.fromEntries(h.map((k,i)=>[k,r[i]])))}
function ownerRow(userId){return rows(OWNER_SHEET).find(r=>String(r.userId).trim()===String(userId).trim())}
function statusMap(){const r=rows(STATUS_SHEET),o={};r.forEach(x=>o[String(x.key)]=x.value);return o}
function statusResponse(){const s=statusMap(),o=ownerRow(s.ownerUserId)||rows(OWNER_SHEET)[0]||{};return {ok:true,name:o.name||'Jain Auto Parts & Service Centre',phone:o.phone||'',address:o.address||'',mapUrl:o.mapUrl||'https://maps.google.com',hours:s.hours||o.hours||'',status:s.status||'CLOSED',message:s.message||'',openUntil:s.openUntil||'',nextOpenAt:s.nextOpenAt||'',updatedAt:s.updatedAt||''}}
function login(userId,password){const o=ownerRow(userId); if(!o||String(o.password)!==String(password))return {ok:false,error:'Invalid User ID or password.'}; const token=Utilities.getUuid(); PropertiesService.getScriptProperties().setProperty('TOKEN_'+userId,token); return Object.assign({ok:true,token:token},statusResponse())}
function session(userId,token){const good=PropertiesService.getScriptProperties().getProperty('TOKEN_'+userId); if(!good||good!==token)return {ok:false,error:'Session expired.'};return Object.assign({ok:true},statusResponse())}
function update(p){const good=PropertiesService.getScriptProperties().getProperty('TOKEN_'+p.userId);if(!good||good!==p.token)return {ok:false,error:'Please sign in again.'};const s=sheet(STATUS_SHEET);const data=s.getDataRange().getValues();const map={};data.forEach((r,i)=>{if(i>0)map[String(r[0])]=i+1});const values={ownerUserId:p.userId,status:p.status||'CLOSED',message:p.message||'',openUntil:p.openUntil||'',nextOpenAt:p.nextOpenAt||'',hours:p.hours||'',updatedAt:new Date().toISOString()};Object.keys(values).forEach(k=>{if(map[k])s.getRange(map[k],2).setValue(values[k]);else s.appendRow([k,values[k]])});return Object.assign({ok:true},statusResponse())}
function setup(){const ss=SpreadsheetApp.getActive();let o=ss.getSheetByName(OWNER_SHEET);if(!o)o=ss.insertSheet(OWNER_SHEET);if(o.getLastRow()===0)o.appendRow(['userId','password','name','phone','address','mapUrl','hours']);let s=ss.getSheetByName(STATUS_SHEET);if(!s)s=ss.insertSheet(STATUS_SHEET);if(s.getLastRow()===0){s.appendRow(['key','value']);[['ownerUserId','owner1'],['status','CLOSED'],['message','We are currently closed.'],['openUntil',''],['nextOpenAt',''],['hours','09:00 AM – 08:00 PM'],['updatedAt',new Date().toISOString()]].forEach(r=>s.appendRow(r));}if(o.getLastRow()===1)o.appendRow(['owner1','ChangeMe123','Jain Auto Parts & Service Centre','+919999999999','Add shop address','https://maps.google.com','09:00 AM – 08:00 PM']);}
